				<p id="team-name" style="font-size: 25px; font-weight: bold;">Team Name: <span style="font-weight: lighter;">{{ team.name }}</span></p>
			</div>
			<div class="form-box">
				<div id='waiting'>
					{% call forms.form() %}
						<div style="display: flex; flex-direction: row; align-items: center; justify-content: center;">
							<h3 id='info'></h3>
							<div class="loader">
								<svg class="circular">
									<circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="5" stroke-miterlimit="10"></circle>
								</svg>
							</div>
						</div>
					{% endcall %}
				</div>
				<div id="location-code">
					{% call forms.form() %}
					<div class="question">
						<h3>Question</h3>
						<p id="location-question"></p>
					</div>
						{{ forms.field('locationcode', 'Location Code') }}
					<button id="location-submit-button" onclick="this.disabled = true">Submit</button>
					{% endcall %}
				</div>
				<div id="riddle-form">
					{% call forms.form() %}
					<div class="question">
						<h3>Question</h3>
						<p id="riddle-question"></p>
					</div>
					{# {{ forms.field('riddleanswer','Answer') }} #}
					<div class="item select" style="margin: 0;">
						<label style="top: -8px;"></label>
						<select name="riddleanswer" id="riddleanswer" style="height: 40px; font-size: 17px; font-weight: 400;"></select>
					</div>
					<button id="riddle-submit-button" onclick="this.disabled = true">Submit</button>
					{% endcall %}
				</div>
			</div>
		</div>
	</div>
{% else %}
<div> Not Started </div>
{% endif %}
{% endblock %}

