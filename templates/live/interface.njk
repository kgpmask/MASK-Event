        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    #interface-container {
        top: 50%;
        left: 50%;
        position: absolute;
        transform: translate(-50%, -50%);
    }

    .team-info {
        margin-top: 20px;
    }

    .question {
        font-size: 20px;
