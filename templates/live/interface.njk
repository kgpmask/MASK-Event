{% block customjs %}
{{ forms.formFunction() }}
<script>
	axios.defaults.withCredentials = true;
	axios.defaults.headers.common['X-CSRF-TOKEN'] = '{{ csrfToken }}';

	let questions = 6;
	let tries = 0;
	let attempted = 0;
	let endOfTimeout;
	let state;

	const wait = () => {
		document.getElementById('location-code').style.display = 'none'
		document.getElementById('riddle-form').style.display = 'none'
		document.getElementById('waiting').style.display = 'block'
		document.getElementById('info').innerHTML = waitMsg;
	}

	async function start() {
		document.getElementById('instructions').style.display='none'
		document.getElementById('container').style.display='block'
		await renderForm();
	}

	async function getRiddleQuestion () {
		return (await axios.post('/live/get-riddle-question')).data;
	}

	async function getLocationQuestion () {
		return (await axios.post('/live/get-location-question')).data;
	}

	async function renderForm() {
		console.log(state);
		const locationCode = document.getElementById('location-code');
		const riddleForm = document.getElementById('riddle-form');
		const messageBox = document.getElementById("message-box");
		const messageCover = document.getElementById("message-cover");
		const countdown = document.getElementById("countdown");
		const interfaceContainer = document.getElementById('interface-container');
		
		// locationCode.style.display = state === 'location-code' ? 'block' : 'none';
		// riddleForm.style.display = ['riddle-question', 'riddle-timeout'].find((e) => e === state) ? 'block' : 'none';
		messageBox.innerHTML = '';
		messageCover.style.display = 'none';
			if (state === 'completed') {
				document.getElementById('instructions').style.display = 'none';
				document.getElementById('container').style.display = 'none';
				document.getElementById('done-cover').style.display = 'flex';
			}
			if (state === 'location-code') {
				waiting = true;
				waitMsg = 'Fetching Locations'
				wait()
				document.getElementById('location-question').textContent = await getLocationQuestion();
				setTimeout(() => {
					document.getElementById('waiting').style.display = 'none'
					locationCode.style.display = 'block';
				}, Math.floor(4 + Math.random()*3) * 1000);
			} else if (state === 'riddle-question') {
				waiting = true;
				waitMsg = 'Fetching Questions'
				wait()
				const riddleQuestion = await getRiddleQuestion();
				console.log(riddleQuestion);
				if (riddleQuestion) {
					document.getElementById('riddle-question').textContent = riddleQuestion.question;
				}
				document.getElementById('riddleanswer').innerHTML = '<option value="" selected disabled hidden>Choose an answer</option>' + riddleQuestion.keywords.map((keyword, index) => {
					return `<option value="${ index }">${ keyword }</option>`
				}).join(' ')
				setTimeout(() => {
					document.getElementById('waiting').style.display = 'none'
					riddleForm.style.display = 'block';
				}, Math.floor(4 + Math.random()*3) * 1000);
			} else if (state === 'riddle-timeout') {
				return await timeout();
			}
		}

	const timeout = async () => {
		const countdown = document.getElementById("countdown");
		const timeoutContainer = document.getElementById('timeout');
		const interfaceContainer = document.getElementById('interface-container');
		const messageBox = document.getElementById("message-box");
		const messageCover = document.getElementById("message-cover");
		const locationCode = document.getElementById('location-code');
		const riddleForm = document.getElementById('riddle-form');
		const locationButton = document.getElementById('location-submit-button');
		const riddleButton = document.getElementById('riddle-submit-button');
		const countdownHeader = document.getElementById('countdown-header');

		const riddleQuestion = await getRiddleQuestion();
		console.log(riddleQuestion);
		if (riddleQuestion) {
			document.getElementById('riddle-question').textContent = riddleQuestion.question;
		}
		riddleButton.disabled = true;
		document.getElementById('riddleanswer').innerHTML = '<option value="" selected disabled hidden>Choose an answer</option>' + riddleQuestion.keywords.map((keyword, index) => {
					return `<option value="${ index }">${ keyword }</option>`
		}).join(' ')

		let timeleft = Math.floor((new Date(endOfTimeout) - Date.now())/1000);
		const countdownInterval = setInterval(async () => {
			if (timeleft <= 0) {
				clearInterval(countdownInterval);
				state = 'riddle-question';
				riddleButton.textContent = 'Submit';
				riddleButton.disabled = false;
			} else {
				const minutes = Math.floor(timeleft / 60);
				const seconds = timeleft % 60;
				riddleButton.textContent = "Please wait " + (minutes === 0 ? "" : minutes + " min ") + (seconds === 0 ? "" : seconds + " seconds");
				timeleft -= 1;
			}
		}, 1000);
	}
	

	document.addEventListener("DOMContentLoaded", async function () {
		//loadingAnimation();
		document.getElementById("location-submit-button").addEventListener("click", async function (event) {
			event.preventDefault();
			await submit();
		});
		document.getElementById("riddle-submit-button").addEventListener("click", async function (event) {
			event.preventDefault();
			await submit();
		});
		if (localStorage.getItem('encountered-error')) {
			const p = document.querySelector('#instructions p');
			p.innerHTML = 'We encountered an error. Click the button to proceed.';
			localStorage.removeItem('encountered-error');
		}

		document.getElementById('continue').textContent = 'Continue'
		
		const response = await axios.post('/live/get-data', {teamID: {{ team._id }}});
		if (response.data.status === "riddle-timeout") {
			state = response.data.status;
			attempted = response.data.questionsAttempted;
			endOfTimeout = response.data.timeout;
			waitMsg = 'Fetching Questions'
			wait()
			setTimeout(() => {
				document.getElementById('waiting').style.display = 'none'
				document.getElementById('riddle-form').style.display = 'block';
			}, Math.floor(4 + Math.random()*3) * 1000);
			await timeout();
		}
		else{
			state = response.data.status;
			attempted = response.data.questionsAttempted;
			endOfTimeout = response.data.timeout;
			await renderForm();
		}
	});

	async function submit() {
		const data = getData();
		try {
			console.log(data.locationcode.trim());
			const response = await axios.post('/live/submit', {state: state, answer: state === 'location-code'? data.locationcode.trim() : data.riddleanswer, questionNo: attempted});
			if (state === 'location-code') {
				const locationButton = document.getElementById('location-submit-button');
				const messageBox = document.getElementById("message-box");
				messageBox.innerHTML = '<h2 class="correct">Correct Location!</h2>';
				const messageCover = document.getElementById("message-cover");
				messageCover.style.display = 'block';
				state = 'riddle-question';
				setTimeout(async () => {
					messageCover.style.display = "none";
					locationButton.disabled = false;
					await renderForm();
				}, 2000);
			}
			else {
				const riddleButton = document.getElementById('riddle-submit-button');
				const messageBox = document.getElementById("message-box");
				messageBox.innerHTML = '<h2 class="correct">Correct Answer!</h2>';
				const messageCover = document.getElementById("message-cover");
				messageCover.style.display = 'block';
				state = 'location-code';
				attempted++;
				setTimeout(async () => {
					messageCover.style.display = "none";
					document.getElementById('locationcode').value= '';
					riddleButton.disabled = false;
					await renderForm();
				}, 5000);
			}
		}
		catch ( e ) {
			if (e.response.status === 786) console.log(e.response.data);
			else if ( e.response.status === 418 ) {
				const riddleButton = document.getElementById('riddle-submit-button');
				riddleButton.disabled = true;
				const messageBox = document.getElementById("message-box");
				messageBox.innerHTML = '<h2 class="correct">Correct Answer!</h2>';
				const messageCover = document.getElementById("message-cover");
				messageCover.style.display = 'block';
				state = 'location-code';
				attempted++;
				setTimeout(async () => {
					messageCover.style.display = "none";
					state='completed';
					document.getElementById('container').style.display = 'none';
					document.getElementById('done-cover').style.display = 'flex';
				}, 5000);
			}
			else if ( e.response.status === 871 ) {
				localStorage.setItem('encountered-error', true);
				location.reload();
			}
			else if ( e.response.status === 469 ) {
				if ( state === 'location-code' ) {
					const locationButton = document.getElementById('location-submit-button');
					locationButton.disabled = true;
					const messageBox = document.getElementById("message-box");
					messageBox.innerHTML = '<h2 class="incorrect">Incorrect Location Code!</h2>';
					const messageCover = document.getElementById("message-cover");
					messageCover.style.display = 'block';
					setTimeout(() => {
						messageCover.style.display = "none";
						locationButton.disabled = false;
					}, 2000);
				}
				else if ( state === 'riddle-question' ) {
					endOfTimeout = new Date(Date.now() + 125 * 1000);
					const riddleButton = document.getElementById('riddle-submit-button');
					riddleButton.disabled = true;
					const messageBox = document.getElementById("message-box");
					messageBox.innerHTML = '<h2 class="incorrect">Incorrect Answer!</h2>';
					const messageCover = document.getElementById("message-cover");
					messageCover.style.display = 'block';
					state = 'riddle-timeout';
					setTimeout(async () => {
						messageCover.style.display = "none";
						riddleButton.disabled = false;
						await renderForm();
					}, 5000);
				}
			}
		}
	}
</script>
{% endblock %}
