{% extends "_base.njk" %}
{% import '_form.njk' as forms %}

{% set thispage = 'logout' %}
{% set pagetitle = 'Logout' %}

{% set scripts = ['https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js'] %}

{% block pagecontent %}
	{% call forms.form() %}
		{{ forms.heading('h3','Are you sure you want to logout?') }}
		<div class="buttons">
			{{ forms.button('submit', 'No, Return to Home', 'login') }}
			{{ forms.button('submit', 'Yes, logout', 'login') }}
		</div>
	{% endcall %}

{% endblock %}

{% block customcss %}
	{{ forms.formCss() }}
	<style>
		#return {
			background-color: #1bc90f;
		}
		button {
			width: 189px;
		}
	</style>
{% endblock %}

{% block customjs %}
<script>
	const logout = () => {
		axios.post('/logout')
			.then(() => {
				document.querySelector('form').innerHTML = '<h3> Logged Out Successfully </h3>';
				setTimeout(() => window.location.href = '/', 1_500);
			})
			.catch(err => {
				console.log(err);
				return alert(err.response.data.errors[0]);
			});
	}

	const back = () => {
		window.location.href = '/';
	}

	window.onload = () => {
		document.querySelector('#logout').onclick = logout;
		document.querySelector('#return').onclick = back;
	}
</script>
{% endblock %}

